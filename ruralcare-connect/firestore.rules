rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to fetch user's record from DB
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check user roles
    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    // USERS COLLECTION
    // - Authenticated users can read their own profiles.
    // - Registration creates profiles (allow write during signup).
    // - Admin can manage all.
    match /users/{userId} {
      allow create: if true; // Registration
      allow read, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isRole('doctor'));
      allow delete: if isAdmin();
    }

    // DOCTORS COLLECTION
    // - Verified doctors are publicly searchable.
    // - Doctors can update their details, but CANNOT self-verify.
    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == doctorId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == doctorId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // HOSPITALS COLLECTION
    // - Publicly readable, writeable only by admin.
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // APPOINTMENTS COLLECTION
    // - Patients can book appointments.
    // - Connected Patient, Doctor, or Admin can read/update appointment records.
    match /appointments/{appointmentId} {
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read, update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // AVAILABILITY COLLECTION
    // - Readable by any user to check slots.
    // - Writeable by the respective doctor or admin.
    match /availability/{availabilityId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.resource.data.doctorId == request.auth.uid || isAdmin());
    }

    // CONSULTATIONS COLLECTION
    // - Patient and doctor on the appointment can read.
    // - Doctor can create/update records.
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // MEDICAL REPORTS COLLECTION
    // - Private by default. Patient can upload/read/delete.
    // - Authorized doctor or admin can read.
    match /medicalReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isRole('doctor') ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isAdmin());
    }

    // REFERRALS COLLECTION
    // - Connected patient and doctor can read.
    // - Doctor can create/update.
    // - Patient can update status (e.g. accepted, appointment_requested, completed).
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.doctorId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // HEALTH ASSESSMENTS COLLECTION
    // - Authenticated patient can create and read their own assessment history.
    match /healthAssessments/{assessmentId} {
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isRole('doctor') ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isAdmin());
    }

    // NOTIFICATIONS COLLECTION
    // - Users read and update their own notifications.
    match /notifications/{notificationId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // FEEDBACK COLLECTION
    // - Anyone can read doctor feedback.
    // - Patients can create feedback for their consultations.
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // CHATS COLLECTION (and subcollection messages)
    match /chats/{chatId} {
      allow read, update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        request.resource.data.doctorId == request.auth.uid ||
        (request.resource.data.participants != null && request.resource.data.participants.hasAny([request.auth.uid]))
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // CONVERSATIONS COLLECTION
    // - Only participants of the conversation or admin can read/write.
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && (
        resource.data.participants.hasAny([request.auth.uid]) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isAdmin();
    }

    // MESSAGES COLLECTION
    // - Only sender or receiver of the message or admin can read.
    // - Sender can create message.
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid || // mark read
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // CALLS / WEBRTC SIGNALING COLLECTION
    // - Only caller or callee can read, create, or update active call signals.
    match /calls/{callId} {
      allow read, update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.patientId == request.auth.uid ||
        request.resource.data.doctorId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid ||
        isAdmin()
      );

      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated();
      }
    }

    // CALL HISTORY COLLECTION
    // - Connected patient, doctor, or admin can read and log call history records.
    match /callHistory/{historyId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        request.resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }
  }
}
