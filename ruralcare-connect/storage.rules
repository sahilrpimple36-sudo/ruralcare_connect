rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /medical_reports/{patientId}/{allPaths=**} {
      // Only the patient can upload or delete their own medical scans
      allow write: if request.auth != null && request.auth.uid == patientId;
      
      // Patient can view their own reports, and logged-in personnel can read for consults
      allow read: if request.auth != null && (request.auth.uid == patientId || request.auth.token.role == 'doctor' || request.auth.token.role == 'admin' || request.auth != null);
    }
  }
}
